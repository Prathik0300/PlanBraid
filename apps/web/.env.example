# Postgres connection string (Neon or any Postgres host). Use the pooled connection
# string on Neon (the "-pooler" host, transaction-pooling mode) for serverless.
DATABASE_URL=

# App-owned authentication. Use a unique 32+ character secret in every hosted environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth. Both values are required to enable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub App, used only to list repository names when creating a project.
# Create one at github.com/settings/apps/new with Repository permissions -> Metadata:
# Read-only, callback <your-origin>/api/github/callback, and "Request user
# authorization (OAuth) during installation" checked. Leave blank to hide the feature.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Basecamp OAuth. Register the integration at launchpad.37signals.com/integrations.
# The redirect URI must exactly match <your-origin>/api/integrations/basecamp/callback.
# BASECAMP_USER_AGENT must identify the app and include a contact URL or email.
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:3000/api/integrations/basecamp/callback
BASECAMP_USER_AGENT=Planbraid (https://planbraid.com)

# Jira Cloud OAuth 2.0 (3LO). Create the app in Atlassian's developer console, add
# read:jira-work and manage:jira-webhook, enable offline_access in the consent flow,
# and register this exact callback URL.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback

# Slack OAuth v2 + Events API. Create the app at api.slack.com/apps with bot scopes
# chat:write, chat:write.public, channels:read, groups:read, team:read - no scope reads
# message content or the user directory, since Planbraid only ever publishes to Slack.
# Register this exact OAuth redirect URL, and set the Events API Request URL to
# <your-origin>/api/integrations/slack/events, subscribed to app_uninstalled and
# tokens_revoked. SLACK_SIGNING_SECRET is from "Basic Information" and is required to
# verify both the OAuth callback's authenticity and every inbound Events API delivery.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# Authorizes the scheduled integration maintenance routes: the daily one retries durable
# webhook inbox work, performs reconciliation, and renews Jira's dynamic webhooks; the
# minute-level one drains queued Slack messages. Vercel Cron sends this value
# automatically. Self-hosters may use INTEGRATION_CRON_SECRET instead.
CRON_SECRET=
INTEGRATION_CRON_SECRET=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@planbraid.app
