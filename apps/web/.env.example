# Postgres connection string (Supabase, Neon, or any Postgres host). Use the pooled/
# transaction-mode connection string for serverless: Supabase's "Transaction pooler"
# (port 6543) or Neon's "-pooler" host. db/pg-d1.ts never issues named prepared
# statements and keeps every transaction on one checked-out connection, so both are safe.
DATABASE_URL=

# App-owned authentication. Use a unique 32+ character secret in every hosted environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public legal identity shown on /privacy. Set both values in hosted environments so
# privacy requests have a direct, monitored contact rather than the listing fallback.
PLANBRAID_LEGAL_NAME=Planbraid
PRIVACY_CONTACT_EMAIL=

# Optional Google OAuth. Both values are required to enable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub App, used only to list repository names when creating a project.
# Create one at github.com/settings/apps/new with Repository permissions -> Metadata:
# Read-only, callback <your-origin>/api/github/callback, and "Request user
# authorization (OAuth) during installation" checked. Leave blank to hide the feature.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Basecamp OAuth. Register the integration at launchpad.37signals.com/integrations.
# The redirect URI must exactly match <your-origin>/api/integrations/basecamp/callback.
# BASECAMP_USER_AGENT must identify the app and include a contact URL or email.
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:3000/api/integrations/basecamp/callback
BASECAMP_USER_AGENT=Planbraid (https://planbraid.com)

# Jira Cloud OAuth 2.0 (3LO). Create the app in Atlassian's developer console, add
# read:jira-work, read:jira-user, and manage:jira-webhook. offline_access is requested
# directly by the consent flow and does not appear in the Permissions screen. Register
# this exact callback URL.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback

# Slack OAuth v2 + Events API + Interactivity. Create the app at api.slack.com/apps
# with bot scopes chat:write, chat:write.public, channels:read, groups:read, team:read,
# commands - no scope reads message content or the user directory in bulk; the one
# import path (a message shortcut) gets a single message's content pushed to it directly
# in the interaction payload, never a history read. Register this exact OAuth redirect
# URL, and set:
#  - Events API Request URL to <your-origin>/api/integrations/slack/events, subscribed
#    to app_uninstalled and tokens_revoked.
#  - Interactivity & Shortcuts Request URL to
#    <your-origin>/api/integrations/slack/interactions, on. Add a message shortcut
#    named "Create Planbraid task" with callback_id create_planbraid_task.
#  - A slash command /planbraid with Request URL
#    <your-origin>/api/integrations/slack/commands.
# Adding the commands scope to an already-installed app requires reconnecting it in
# Planbraid once - Slack does not retroactively grant new bot scopes to existing
# installs. SLACK_SIGNING_SECRET is from "Basic Information" and is required to verify
# the OAuth callback and every inbound Events/Interactivity/command delivery.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# Authorizes the scheduled integration maintenance routes: one daily cron retries durable
# webhook inbox work, performs reconciliation, and renews Jira's dynamic webhooks; a
# second daily cron drains any queued Slack messages a live request's own waitUntil kick
# (see lib/store.ts's kickSlackDrain) didn't already deliver within seconds. Both run once
# a day - the most frequent schedule Vercel's Hobby plan allows - so real Slack delivery
# depends on the waitUntil kick, not this cron. Vercel Cron sends this value automatically.
# Self-hosters may use INTEGRATION_CRON_SECRET instead.
CRON_SECRET=
INTEGRATION_CRON_SECRET=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@planbraid.app
