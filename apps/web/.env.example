# Postgres connection string (Neon or any Postgres host). Use the pooled connection
# string on Neon (the "-pooler" host, transaction-pooling mode) for serverless.
DATABASE_URL=

# App-owned authentication. Use a unique 32+ character secret in every hosted environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth. Both values are required to enable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub App, used only to list repository names when creating a project.
# Create one at github.com/settings/apps/new with Repository permissions -> Metadata:
# Read-only, callback <your-origin>/api/github/callback, and "Request user
# authorization (OAuth) during installation" checked. Leave blank to hide the feature.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@planbraid.app
